# ── The Smart Mom — Life in Canada ──────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# .env.local is NEVER committed to git (already in .gitignore).
# After editing, run: npm run deploy

# ── 1. Formspree (newsletter + forms) ────────────────────────────────────────
# Sign up at https://formspree.io → create a new form → copy the 8-char ID
# Example: if your form URL is https://formspree.io/f/mwvazzpq → ID = mwvazzpq
VITE_FORMSPREE_ID=YOUR_8_CHAR_ID_HERE

# ── 2. Amazon Associates Canada (affiliate links) ─────────────────────────────
# Sign up at https://affiliate-program.amazon.ca
# After approval, find your "Tracking ID" in the Associates dashboard (e.g. smartmom-20)
VITE_AMAZON_TAG=YOUR-TAG-20

# ── 3. Custom domain (optional — only needed if using a domain other than GitHub Pages)
# Set this if you have connected thesmartmom.ca or similar
# VITE_SITE_DOMAIN=thesmartmom.ca
